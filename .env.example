# Copy to .env. Every variable under "required to serve" must be set:
# `cargo run -p demo` validates all seven at startup and exits non-zero
# naming the first one missing. `.env` is gitignored; this file is not, so
# it carries placeholders only.

# --- required to serve: secret (never logged, never in a URL) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/billing
STRIPE_SECRET_KEY=sk_test_replace_me
# the whsec_... printed by `stripe listen`
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_replace_me
# HS256 secret for demo's own /demo/token; demo-only scaffolding
BILLING_JWT_SECRET=replace_me_demo_only

# --- required to serve: not secret ---
# where Stripe returns the customer after / on abandoning Checkout (D6).
# Point at the Vite dev server: success hits the SPA's one return route,
# cancel goes back to the app root. Host config, never a request field.
CHECKOUT_SUCCESS_URL=http://localhost:5173/checkout/return
CHECKOUT_CANCEL_URL=http://localhost:5173/
PORT=8080

# --- optional ---
RUST_LOG=info,demo=debug

# --- `cargo run -p demo -- seed` only: never required to serve ---
# Two prices (and their products) in your own Stripe test-mode account.
# Not hardcoded: a wrong id would leave mirror rows pointing at nothing.
SEED_PLAN_A_STRIPE_PRICE_ID=price_replace_me
SEED_PLAN_A_STRIPE_PRODUCT_ID=prod_replace_me
SEED_PLAN_B_STRIPE_PRICE_ID=price_replace_me
SEED_PLAN_B_STRIPE_PRODUCT_ID=prod_replace_me

# --- frontend: VITE_-prefixed variables are inlined into the browser bundle ---
# Publishable key only. The secret key above must never gain this prefix (F3).
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
